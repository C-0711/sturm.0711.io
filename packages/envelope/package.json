{
  "name": "@0711/envelope",
  "version": "0.1.0",
  "private": true,
  "description": "Project-scoped HMAC envelope + extraction-fingerprint signing for the 0711 platform. Shared between sturm, eyeAI, and the gateway. No build step (tsx runtime).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./envelope": "./src/envelope.ts",
    "./master": "./src/master.ts",
    "./fingerprint": "./src/fingerprint.ts",
    "./canonical": "./src/canonical.ts",
    "./keys": "./src/keys.ts"
  },
  "files": ["src"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx src/envelope.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
