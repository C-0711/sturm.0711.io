{
  "templates": [
    {
      "id": "elster/steuerpflichtige-person",
      "name": "ELSTER · Steuerpflichtige Person",
      "description": "Stammdaten der steuerpflichtigen Person inkl. Identifikationsmerkmale, Anschrift und Steuerklasse.",
      "defaultPrompt": "Beträge in EUR. Komma als Dezimaltrennzeichen. Steuer-ID 11-stellig. Datumsformat DD.MM.YYYY.",
      "schema": {
        "type": "object",
        "properties": {
          "vorname": { "type": "string" },
          "nachname": { "type": "string" },
          "geburtsdatum": { "type": "string", "format": "date", "description": "ISO-Datum YYYY-MM-DD" },
          "steueridentifikationsnummer": { "type": "string", "pattern": "^\\d{11}$" },
          "religion": { "type": "string", "enum": ["rk", "ev", "ak", "andere", "vd", "keine"] },
          "steuerklasse": { "type": "integer", "minimum": 1, "maximum": 6 },
          "anschrift": {
            "type": "object",
            "properties": {
              "strasse": { "type": "string" },
              "hausnummer": { "type": "string" },
              "plz": { "type": "string", "pattern": "^\\d{5}$" },
              "ort": { "type": "string" },
              "land": { "type": "string" }
            },
            "required": ["strasse", "plz", "ort"],
            "additionalProperties": false
          }
        },
        "required": ["vorname", "nachname", "steueridentifikationsnummer"],
        "additionalProperties": false
      }
    },
    {
      "id": "elster/bankverbindung",
      "name": "ELSTER · Bankverbindung",
      "description": "IBAN/BIC und Kontoinhaber für Erstattung oder Lastschrift.",
      "defaultPrompt": "IBAN entspricht ^DE\\d{20}$. Leerzeichen entfernen. Beträge in EUR.",
      "schema": {
        "type": "object",
        "properties": {
          "iban": { "type": "string", "pattern": "^DE\\d{20}$" },
          "bic": { "type": "string", "pattern": "^[A-Z]{6}[A-Z0-9]{2}([A-Z0-9]{3})?$" },
          "kontoinhaber": { "type": "string" },
          "kreditinstitut": { "type": "string" }
        },
        "required": ["iban", "kontoinhaber"],
        "additionalProperties": false
      }
    },
    {
      "id": "elster/anlagen-klassifizierung",
      "name": "ELSTER · Anlagen-Klassifizierung",
      "description": "Erkannte ELSTER-Anlagen (KAP, N, AV, ESt1A, etc.) mit Konfidenz.",
      "defaultPrompt": "Erkenne ELSTER-Anlagen-Codes: ESt1A, N, AV, KAP, R, S, V, U, K, Kind, Vorsorgeaufwand, Sonderausgaben, AUS, G, S-Vermietung. Listen aller eindeutig erkannten Anlagen ausgeben. Jede einmal.",
      "schema": {
        "type": "object",
        "properties": {
          "anlagen": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": { "type": "string", "enum": ["ESt1A", "N", "AV", "KAP", "R", "S", "V", "U", "K", "Kind", "Vorsorgeaufwand", "Sonderausgaben", "AUS", "G", "S-Vermietung", "Sonstige"] },
                "seite": { "type": "integer", "minimum": 1 },
                "konfidenz": { "type": "string", "enum": ["hoch", "mittel", "niedrig"] }
              },
              "required": ["code"],
              "additionalProperties": false
            }
          }
        },
        "required": ["anlagen"],
        "additionalProperties": false
      }
    },
    {
      "id": "belege/rechnung",
      "name": "Beleg · Rechnung",
      "description": "Rechnungsdaten inkl. Positionen.",
      "defaultPrompt": "Beträge in EUR. Komma als Dezimaltrennzeichen → Punkt für JSON. Datumsformat YYYY-MM-DD. Brutto, Netto und Umsatzsteuer separat ausweisen.",
      "schema": {
        "type": "object",
        "properties": {
          "rechnungsnummer": { "type": "string" },
          "rechnungsdatum": { "type": "string", "format": "date" },
          "leistungsdatum": { "type": "string", "format": "date" },
          "verkaeufer": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "anschrift": { "type": "string" },
              "ustid": { "type": "string", "pattern": "^DE\\d{9}$" }
            },
            "required": ["name"],
            "additionalProperties": false
          },
          "kaeufer": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "anschrift": { "type": "string" }
            },
            "required": ["name"],
            "additionalProperties": false
          },
          "netto": { "type": "number" },
          "ust_satz": { "type": "number", "description": "Prozent, z.B. 19" },
          "ust_betrag": { "type": "number" },
          "brutto": { "type": "number" },
          "waehrung": { "type": "string", "enum": ["EUR", "USD", "CHF", "GBP"] },
          "positionen": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bezeichnung": { "type": "string" },
                "menge": { "type": "number" },
                "einheit": { "type": "string" },
                "einzelpreis": { "type": "number" },
                "gesamtpreis": { "type": "number" }
              },
              "required": ["bezeichnung", "gesamtpreis"],
              "additionalProperties": false
            }
          }
        },
        "required": ["rechnungsnummer", "rechnungsdatum", "verkaeufer", "brutto"],
        "additionalProperties": false
      }
    },
    {
      "id": "belege/spende",
      "name": "Beleg · Spendenquittung",
      "description": "Zuwendungsbestätigung — gemeinnützige Organisation.",
      "defaultPrompt": "Beträge in EUR. Datum als YYYY-MM-DD. Unterschrift-Vorhandensein als Boolean. Spendenzweck wörtlich übernehmen.",
      "schema": {
        "type": "object",
        "properties": {
          "organisation": { "type": "string" },
          "anschrift_organisation": { "type": "string" },
          "spender_name": { "type": "string" },
          "spender_anschrift": { "type": "string" },
          "spendendatum": { "type": "string", "format": "date" },
          "betrag": { "type": "number" },
          "waehrung": { "type": "string", "enum": ["EUR"] },
          "verwendungszweck": { "type": "string" },
          "art": { "type": "string", "enum": ["Geldzuwendung", "Sachzuwendung", "Mitgliedsbeitrag"] },
          "unterschrift_vorhanden": { "type": "boolean" }
        },
        "required": ["organisation", "spendendatum", "betrag"],
        "additionalProperties": false
      }
    }
  ]
}
