{
  "name": "0711-sturm",
  "version": "0.1.0",
  "description": "Workflow-Engine für LLM/OCR-Pipelines",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test:codec": "tsx src/lib/mistral-ocr/codec.test.ts",
    "test:schema": "tsx src/server/schema-generate.test.ts",
    "test:gitchain": "tsx src/lib/gitchain-client.test.ts",
    "test": "npm run test:codec && npm run test:schema && npm run test:gitchain"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.20.0",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
