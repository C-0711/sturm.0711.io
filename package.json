{
  "name": "0711-sturm",
  "version": "0.1.0",
  "description": "Workflow-Engine für LLM/OCR-Pipelines",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test:codec": "tsx src/lib/mistral-ocr/codec.test.ts",
    "test:schema": "tsx src/server/schema-generate.test.ts",
    "test:gitchain": "tsx src/lib/gitchain-client.test.ts",
    "test:pentacam-kc": "tsx src/workflows/pentacam-kc/pentacam-kc.test.ts",
    "test:myopia": "tsx src/workflows/myopia-progression/myopia-progression.test.ts",
    "test:applications": "tsx src/server/applications.test.ts",
    "test:seal": "tsx src/stages/seal/seal.test.ts",
    "test:ensemble": "tsx src/verticals/elster-v3/stages/phase3-ensemble-merge.test.ts",
    "test:aggregation": "tsx src/server/aggregation.test.ts",
    "test:e2e:designer": "node tests/e2e/designer.mjs",
    "verify:tools": "node scripts/verify-tools.mjs",
    "lint:no-env": "node scripts/lint-no-env.mjs",
    "test": "npm run test:codec && npm run test:schema && npm run test:gitchain && npm run test:pentacam-kc && npm run test:myopia && npm run test:applications && npm run test:seal && npm run test:ensemble && npm run test:aggregation",
    "build:ui": "npm run build:ui:pipeline && npm run build:ui:designer",
    "build:ui:pipeline": "esbuild src/ui/pipeline.jsx --bundle=false --loader:.jsx=jsx --jsx=transform --target=es2020 --minify --outfile=src/ui/pipeline.bundle.js",
    "build:ui:designer": "esbuild src/ui/designer.jsx --bundle=false --loader:.jsx=jsx --jsx=transform --target=es2020 --minify --outfile=src/ui/designer.bundle.js",
    "test:e2e:ui:smoke": "node scripts/ui-regression.mjs --smoke-only",
    "test:e2e:ui:visual": "node scripts/ui-regression.mjs",
    "test:e2e:sister-parity": "node scripts/sister-parity-probe.mjs"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.20.0",
    "simple-git": "^3.36.0",
    "undici": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.27.7",
    "puppeteer-core": "^24.43.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "playwright": "^1.54.1",
    "pngjs": "^7.0.0",
    "pixelmatch": "^7.1.0"
  }
}
