# REACTOR — production env template
#
# Copy to `.env.production` and fill in. NEVER commit `.env.production`.
# Production secrets MUST come from the gateway vault (0711:gateway:auth:v1)
# or the platform secrets manager — never from 0711-ALLES.rtf or any
# cleartext file.

# ─── Workflow engine (STURM web + SSE) ───────────────────────────────────
PORT=7800
NODE_ENV=production

# ─── RAG read-API (Gemma 4 over signed gitchain containers) ──────────────
# New in Phase F.2: the deterministic answerer over Layer 4 outputs.
STURM_RAG_PORT=7813
STURM_RAG_BIND=127.0.0.1

# ─── Model hosts ─────────────────────────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
# Pin the Gemma model identity so RAG answers stay reproducible across
# REACTOR rebuilds. Empty → uses the latest tag on the host.
STURM_GEMMA_MODEL=gemma2:27b
STURM_EMBEDDING_MODEL=bge-m3

# Provider keys come from the vault, not from this file. Leave empty here.
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# ─── Gitchain container store ────────────────────────────────────────────
STURM_ARTIFACT_BACKEND=gitchain
GITCHAIN_DATABASE_URL=postgresql://gitchain@127.0.0.1:5433/gitchain
GITCHAIN_REPO_ROOT=/var/lib/gitchain/repos
GITCHAIN_API_URL=http://127.0.0.1:3361
GITCHAIN_DEFAULT_NAMESPACE=elster
GITCHAIN_DEFAULT_TENANT=ctax-0711

# ─── Anchor chain (Phase F.3 wiring) ─────────────────────────────────────
# Base mainnet for production anchor; Sepolia for staging. Empty disables
# anchoring (containers still get Ed25519 + Merkle, but no on-chain proof).
STURM_ANCHOR_CHAIN=base
STURM_ANCHOR_RPC=
STURM_ANCHOR_WALLET_ADDRESS=
# Private key NEVER in env. Vault-only.

# ─── Auth + retention ────────────────────────────────────────────────────
# When set, all /api/ocr/*, /studio-ocr.html, stage-config writes, and
# run-input reads require Authorization: Bearer <token>.
STURM_BEARER_TOKEN=
STURM_INPUT_RETENTION_DAYS=7

# ─── Observability ───────────────────────────────────────────────────────
STURM_LOG_LEVEL=info
STURM_METRICS_PORT=9100
