PORT=7800
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434

# GitChain Integration (optional — leer lassen für reinen Filesystem-Betrieb)
STURM_ARTIFACT_BACKEND=filesystem    # filesystem|gitchain
GITCHAIN_DATABASE_URL=postgresql://gitchain:gitchain_password_2026@localhost:5433/gitchain
GITCHAIN_REPO_ROOT=/home/christoph.bertsch/gitchain-repos
GITCHAIN_API_URL=http://localhost:3361
GITCHAIN_DEFAULT_NAMESPACE=ctax
GITCHAIN_DEFAULT_TENANT=ctax-0711

# Opt-in bearer-token gate for the OCR Studio + protected APIs.
# Unset → studio is publicly reachable (warning logged at startup).
# Set    → all /api/ocr/*, /studio-ocr.html, stage-config writes, and run-input
#          reads require `Authorization: Bearer <token>`. The studio reads the
#          token once from `?token=…` and stores it in localStorage.
STURM_BEARER_TOKEN=

# How many days to keep persisted run inputs (runs/<wf>/<run>/_input/) before
# the upload sweeper deletes them. Default 7. Uploads/ files are always nuked
# after 1h regardless.
STURM_INPUT_RETENTION_DAYS=7

# ── Master signing (Ed25519 .master-key.json + HMAC) ─────────────────────
# Used by master-signer.ts to sign master.json per workspace.
# Required when running with master verification enabled.
STURM_MASTER_HMAC_KEY=

# ── Docker Compose only ──────────────────────────────────────────────────
# Bundled Postgres password (only read by docker-compose.yml).
POSTGRES_PASSWORD=
