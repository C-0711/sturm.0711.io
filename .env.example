PORT=7800
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434

# GitChain Integration (optional — leer lassen für reinen Filesystem-Betrieb)
STURM_ARTIFACT_BACKEND=filesystem    # filesystem|gitchain
GITCHAIN_DATABASE_URL=postgresql://gitchain:gitchain_password_2026@localhost:5433/gitchain
GITCHAIN_REPO_ROOT=/home/christoph.bertsch/gitchain-repos
GITCHAIN_API_URL=http://localhost:3361
GITCHAIN_DEFAULT_NAMESPACE=ctax
GITCHAIN_DEFAULT_TENANT=ctax-0711

# Opt-in bearer-token gate for the OCR Studio + protected APIs.
# Unset → studio is publicly reachable (warning logged at startup).
# Set    → all /api/ocr/*, /studio-ocr.html, stage-config writes, and run-input
#          reads require `Authorization: Bearer <token>`. The studio reads the
#          token once from `?token=…` and stores it in localStorage.
STURM_BEARER_TOKEN=

# How many days to keep persisted run inputs (runs/<wf>/<run>/_input/) before
# the upload sweeper deletes them. Default 7. Uploads/ files are always nuked
# after 1h regardless.
STURM_INPUT_RETENTION_DAYS=7

# ── Master signing (Ed25519 .master-key.json + HMAC) ─────────────────────
# Used by master-signer.ts to sign master.json per workspace.
# Required when running with master verification enabled.
STURM_MASTER_HMAC_KEY=

# ── Lane-5 ELSTER MCP (Einreichung) ──────────────────────────────────────
# Optional. Leer/unset → ElsterMcpClient.einreichen() liefert deterministisch
# { erfolg: false, reason: 'mcp-unavailable' }. Sobald der Lane-5-Service
# läuft (z.B. via SSH-Tunnel `-L 12015:localhost:12015`), URL setzen:
# ELSTER_MCP_URL=http://localhost:12015/mcp
ELSTER_MCP_URL=

# ── Beleg-API (eigenständiger Hintergrund-Daemon) ────────────────────────
# Belege rein (Ordner-Drop in posteingang/ ODER POST /beleg), perfekte JSON+MD
# raus nach ausgang/. Komplett entkoppelt vom STURM-Server. Nur ANTHROPIC_API_KEY
# ist Pflicht (oben gesetzt). Alle BELEG_* sind optional mit sinnvollen Defaults.
BELEG_PORT=7810                  # HTTP-Intake-Port
# BELEG_ROOT=/abs/pfad/beleg-api-data   # Basis aller Ordner (default: <repo>/beleg-api-data)
# BELEG_MODELL=claude-opus-4-8    # Kurator-Modell (intern; UI/Log zeigt "Kurator")
# BELEG_MAX_MB=32                 # Max. Dateigröße (Anthropic-PDF-Limit)
# BELEG_PARALLEL=3                # Gleichzeitig kuratierte Belege
# BELEG_POLL_MS=1500              # Poll-Intervall des Ordner-Wächters
# BELEG_ARCHIVIEREN=1             # 1=Original nach archiv/, 0=löschen
# BELEG_HTTP=1                    # 0=reiner Ordner-Betrieb ohne HTTP
# BELEG_TOKEN=                    # gesetzt → Bearer-Token-Pflicht am Intake
# BELEG_DEFAULT_FALL=Fall 1       # Fall für Belege ohne Unterordner/X-Fall
# BELEG_MASTERCASE_AUTO=1         # nach jedem Beleg mastercase_<Fall>.json neu schreiben
# BELEG_CACHE=1                   # Duplikate (gleicher sha256) ohne erneuten Opus-Call bedienen
# BELEG_CACHE_DIR=…               # Cache-Ordner (default: <root>/cache)
# BELEG_KENNZAHLEN_PATH=…         # ELSTER-SSoT (default: src/verticals/elster/data/postgres-dumps/elster_kennzahlen.json)

# ── Docker Compose only ──────────────────────────────────────────────────
# Bundled Postgres password (only read by docker-compose.yml).
POSTGRES_PASSWORD=

# ── Tool-Bindings (P0: Anwendung-Tools für CTAX) ──────────────────────
# vLLM @ H200V: gemma4-mm (Gemma-4 31B IT, 65K ctx, TP2)
VLLM_URL=http://host.docker.internal:11435
# Lane-5 ELSTER MCP — ERiC-XML Einreichung
ELSTER_MCP_URL=http://host.docker.internal:12014/mcp
# Gitchain — Container-Registry + git-Anker
GITCHAIN_API_URL=http://host.docker.internal:3361
GITCHAIN_DATABASE_URL=postgres://gitchain:gitchain@host.docker.internal:5440/gitchain
GITCHAIN_REPO_ROOT=/var/lib/gitchain/repos
